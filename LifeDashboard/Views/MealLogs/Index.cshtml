@model IEnumerable<LifeDashboard.Models.MealLogModel>

@{
    ViewData["Title"] = "Jurnal Nutriție";
    
    // Calculăm procentele pentru barele de progres
    int targetCals = ViewBag.TargetCalories ?? 2000;
    int targetProts = ViewBag.TargetProteins ?? 140;
    
    int pctCalories = (int)((double)ViewBag.TotalCalories / targetCals * 100);
    int pctProteins = (int)((double)ViewBag.TotalProteins / targetProts * 100);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5">🍏 Jurnal Nutriție (Azi)</h1>
        <a asp-action="Create" class="btn btn-success">➕ Adaugă Aliment/Masă</a>
    </div>

    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm p-3 h-100">
                <h5 class="fw-bold text-muted mb-3">⚙️ Setează Obiectivele</h5>
                <form asp-action="UpdateTargets" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Țintă Calorii (kcal)</label>
                        <input type="number" name="targetCalories" class="form-control form-control-sm" value="@targetCals" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Țintă Proteine (g)</label>
                        <input type="number" name="targetProteins" class="form-control form-control-sm" value="@targetProts" />
                    </div>
                    <button type="submit" class="btn btn-sm btn-dark w-100">💾 Actualizează Țintele</button>
                </form>
            </div>
        </div>

        <div class="col-md-8 mb-3">
            <div class="card shadow-sm p-3 h-100">
                <h5 class="fw-bold text-muted mb-3">📊 Progresul de Astăzi</h5>
                
                <div class="mb-3">
                    <div class="d-flex justify-content-between small fw-bold mb-1">
                        <span>🔥 Calorii: @ViewBag.TotalCalories / @targetCals kcal</span>
                        <span>@pctCalories%</span>
                    </div>
                    <div class="progress" style="height: 20px;">
                        <div class="progress-bar bg-danger" role="progressbar" style="width: @(pctCalories > 100 ? 100 : pctCalories)%;" aria-valuenow="@pctCalories" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>

                <div class="mb-2">
                    <div class="d-flex justify-content-between small fw-bold mb-1">
                        <span>🥩 Proteine: @ViewBag.TotalProteins / @targetProts g</span>
                        <span>@pctProteins%</span>
                    </div>
                    <div class="progress" style="height: 20px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: @(pctProteins > 100 ? 100 : pctProteins)%;" aria-valuenow="@pctProteins" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-3 justify-content-center border-top pt-2 small text-muted">
                    <span>🍞 Carbohidrați: <strong>@ViewBag.TotalCarbs g</strong></span>
                    <span>🥑 Grăsimi: <strong>@ViewBag.TotalFats g</strong></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm p-3">
        <h5 class="fw-bold mb-3">Mesele înregistrate astăzi</h5>
        @if (!Model.Any())
        {
            <p class="text-muted text-center my-4">Nu ai adăugat niciun aliment pentru ziua de azi încă.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Aliment / Masă</th>
                            <th class="text-center">Calorii</th>
                            <th class="text-center">Proteine</th>
                            <th class="text-center">Carbs</th>
                            <th class="text-center">Grăsimi</th>
                            <th class="text-center">Opțiuni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.FoodName</td>
                                <td class="text-center text-danger fw-bold">@item.Calories kcal</td>
                                <td class="text-center text-primary">@item.Proteins g</td>
                                <td class="text-center text-success">@item.Carbs g</td>
                                <td class="text-center text-warning">@item.Fats g</td>
                                <td class="text-center">
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Ștergi acest aliment din jurnal?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none p-0">🗑️ Șterge</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
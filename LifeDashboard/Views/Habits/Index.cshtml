@model IEnumerable<LifeDashboard.Models.Habit>

@{
    ViewData["Title"] = "Manager Obiceiuri";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5">⚡ Obiceiurile Mele Zilnice</h1>
        <a asp-action="Create" class="btn btn-success">➕ Adaugă Obicei Nou</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-success text-center" role="alert">
            Nu ai definit niciun obicei încă. Începe prin a adăuga unul acum!
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-start border-4 border-success">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@item.Title</h5>
                            <p class="card-text text-muted small">@item.Description</p>
                            
                            <hr />
                            
                            <div class="d-flex justify-content-between align-items-center my-3">
                                <div>
                                    <span class="fs-4">🔥 @item.Streak</span>
                                    <span class="text-muted small d-block">Zile consecutive</span>
                                </div>
                                <div>
                                    <form asp-action="CheckIn" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success">✅ Bifează pentru Azi</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent d-flex justify-content-between">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-link text-secondary text-decoration-none">✏️ Editează</a>
                            
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Ești sigur că vrei să ștergi acest obicei?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none">🗑️ Șterge</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
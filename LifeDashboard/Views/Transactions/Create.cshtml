@model LifeDashboard.Models.TransactionModel

@{
    ViewData["Title"] = "Adaugă Tranzacție";
}

<div class="container mt-4" style="max-width: 600px;">
    <h1 class="display-6 mb-4">➕ Înregistrează o Tranzacție</h1>

    <div class="card shadow-sm p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold">Descriere / Detalii</label>
                <input asp-for="Description" class="form-control" placeholder="Ex: Salariu, Cumpărături Lidl, Factură curent..." />
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Amount" class="form-label fw-bold">Sumă (RON)</label>
                    <input asp-for="Amount" type="number" step="0.01" class="form-control" placeholder="0.00" />
                    <span asp-validation-for="Amount" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6 mb-3">
                    <label asp-for="Type" class="form-label fw-bold">Tip Tranzacție</label>
                    <select asp-for="Type" class="form-select">
                        <option value="Expense">Cheltuială (Expense)</option>
                        <option value="Income">Venit (Income)</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label fw-bold">Categorie</label>
                <input asp-for="Category" class="form-control" placeholder="Ex: Mâncare, Utilități, Transport, Divertisment..." />
                <span asp-validation-for="Category" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">🔙 Înapoi la listă</a>
                <button type="submit" class="btn btn-primary">💾 Salvează Tranzacția</button>
            </div>
        </form>
    </div>
</div>
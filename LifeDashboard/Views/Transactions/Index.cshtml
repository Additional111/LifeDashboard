@model IEnumerable<LifeDashboard.Models.TransactionModel>

@{
    ViewData["Title"] = "Manager Finanțe";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5">💰 Buget & Finanțe</h1>
        <a asp-action="Create" class="btn btn-primary">➕ Adaugă Tranzacție</a>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-light p-3">
                <span class="text-muted small fw-bold text-uppercase">Balanță Totală</span>
                <h2 class="fw-bold @(ViewBag.Balance >= 0 ? "text-success" : "text-danger")">@ViewBag.Balance.ToString("C2")</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-success text-white p-3">
                <span class="text-white-50 small fw-bold text-uppercase">Venituri (Incomes)</span>
                <h2 class="fw-bold">@ViewBag.TotalIncome.ToString("C2")</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 bg-danger text-white p-3">
                <span class="text-white-50 small fw-bold text-uppercase">Cheltuieli (Expenses)</span>
                <h2 class="fw-bold">@ViewBag.TotalExpenses.ToString("C2")</h2>
            </div>
        </div>
    </div>

    <div class="card shadow-sm p-3">
        <h5 class="fw-bold mb-3">Istoric Tranzacții</h5>
        
        @if (!Model.Any())
        {
            <p class="text-muted text-center my-4">Nu ai înregistrat nicio tranzacție încă.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Dată</th>
                            <th>Descriere</th>
                            <th>Categorie</th>
                            <th>Tip</th>
                            <th class="text-end">Sumă</th>
                            <th class="text-center">Acțiuni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-muted small">@item.Date.ToString("dd MMM yyyy")</td>
                                <td class="fw-bold">@item.Description</td>
                                <td><span class="badge bg-secondary">@item.Category</span></td>
                                <td>
                                    @if (item.Type == "Income")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Venit</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Cheltuială</span>
                                    }
                                </td>
                                <td class="text-end fw-bold @(item.Type == "Income" ? "text-success" : "text-danger")">
                                    @(item.Type == "Income" ? "+" : "-")@item.Amount.ToString("C2")
                                </td>
                                <td class="text-center">
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Ștergi această tranzacție?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none p-0">🗑️ Șterge</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
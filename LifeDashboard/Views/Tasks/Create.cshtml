@model LifeDashboard.Models.TaskItem

@{
    ViewData["Title"] = "Adaugă Task Nou";
}

<div class="container mt-4" style="max-width: 600px;">
    <h1 class="display-6 mb-4">➕ Adaugă un Task Nou</h1>

    <div class="card shadow-sm p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-bold">Titlu Task</label>
                <input asp-for="Title" class="form-control" placeholder="Ex: Cumpără lapte..." />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold">Descriere (Opțional)</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Alte detalii importante..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DueDate" class="form-label fw-bold">Data Limită</label>
                <input asp-for="DueDate" type="date" class="form-control" />
                <span asp-validation-for="DueDate" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary">🔙 Înapoi la listă</a>
                <button type="submit" class="btn btn-primary">💾 Salvează Task-ul</button>
            </div>
        </form>
    </div>
</div>